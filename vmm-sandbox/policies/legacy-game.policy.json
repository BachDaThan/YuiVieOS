{
  "version": 1,
  "app": "app:legacy-game",
  "tier": "microvm",
  "capabilities": [
    "gpu",
    "net.connect",
    "net:*.steampowered.com",
    "power"
  ],
  "deny": ["fs.read", "fs.write", "input"],
  "persistent_storage": true,
  "allow_child_processes": false,
  "allow_east_west": false,
  "allow_direct_dns": false
}
