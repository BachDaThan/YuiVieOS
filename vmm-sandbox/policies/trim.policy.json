{
  "version": 1,
  "app": "app:trim",
  "tier": "isolated",
  "capabilities": [
    "fs.read",
    "fs.write",
    "fs:/home/user/Applications:rw",
    "fs:/tmp/yui-trim:rw"
  ],
  "deny": ["/home/user/.ssh", "/etc/shadow"],
  "persistent_storage": false,
  "allow_child_processes": false,
  "allow_east_west": false,
  "allow_direct_dns": false
}
