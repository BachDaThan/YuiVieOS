#!/usr/bin/env python3
"""Minimal pkg-config implementation for out-of-tree builds when system pkg-config is not installed."""
import os
import sys

def parse_pc(path):
    variables = {}
    metadata = {}
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" in line and not line.startswith(("Libs:", "Cflags:", "Name:", "Description:", "Version:")):
                k, v = line.split("=", 1)
                k = k.strip()
                v = v.strip()
                for var_k, var_v in variables.items():
                    v = v.replace(f"${{{var_k}}}", var_v)
                variables[k] = v
            elif ":" in line:
                k, v = line.split(":", 1)
                k = k.strip()
                v = v.strip()
                for var_k, var_v in variables.items():
                    v = v.replace(f"${{{var_k}}}", var_v)
                metadata[k] = v
    return metadata

def find_pc(pkg_name):
    search_dirs = []
    if "PKG_CONFIG_PATH" in os.environ:
        search_dirs.extend(os.environ["PKG_CONFIG_PATH"].split(":"))
    search_dirs.extend([
        os.path.abspath(os.path.join(os.path.dirname(__file__), "../build")),
        "/usr/local/lib/pkgconfig",
        "/usr/lib/pkgconfig",
        "/usr/share/pkgconfig",
    ])
    for d in search_dirs:
        candidate = os.path.join(d, f"{pkg_name}.pc")
        if os.path.isfile(candidate):
            return candidate
    return None

def main():
    args = sys.argv[1:]
    if not args:
        sys.exit(1)

    cflags = "--cflags" in args
    libs = "--libs" in args
    version = "--modversion" in args
    exists = "--exists" in args

    pkgs = [a for a in args if not a.startswith("-")]
    if not pkgs:
        sys.exit(1)

    pkg = pkgs[0]
    pc_file = find_pc(pkg)
    if not pc_file:
        sys.exit(1)

    if exists:
        sys.exit(0)

    data = parse_pc(pc_file)
    outputs = []
    if cflags:
        outputs.append(data.get("Cflags", ""))
    if libs:
        outputs.append(data.get("Libs", ""))
    if version:
        outputs.append(data.get("Version", ""))

    print(" ".join(outputs).strip())

if __name__ == "__main__":
    main()
